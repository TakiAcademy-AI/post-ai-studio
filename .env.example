# Web chỉ nghe localhost (gflow cần Chrome + profile Google đã đăng nhập trên chính máy này)
HOST=127.0.0.1
PORT=3200

# Claude: dùng CLI `claude` đã đăng nhập (gói đăng ký), không cần API key
CLAUDE_BIN=claude
# CLAUDE_MODEL=opus

# gflow-cli
GFLOW_BIN=/home/taki/Downloads/gflow-cli/.venv/bin/gflow
GFLOW_PROFILE=ai
GFLOW_MODEL=veo-lite

# Facebook Page — nên dùng token System User đã được gán Page (không hết hạn)
# Quyền cần: pages_show_list, pages_read_engagement, pages_manage_posts
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v23.0

# Facebook Login — nút "Đăng nhập Facebook" (dùng chung app với Ads OS).
# Redirect URI cần cho phép trong app: http://localhost:3200/api/fb/callback
FB_APP_ID=
FB_APP_SECRET=
# Khoá mã hoá token lưu trên đĩa (64 ký tự hex). Đổi khoá = phải đăng nhập lại.
ENCRYPTION_KEY=
